<?xml version="1.0" encoding="UTF-8"?>
<!-- Console-only logging for the adapter under test. The bundled logback.xml wires in the JavaFX
     TextAreaLogAppender, which a -nojfx jar on a plain JDK cannot load. -->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{24} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Same file the bundled config writes, under the LOG_DIR each test sets per adapter. -->
  <appender name="FILE" class="ch.qos.logback.core.FileAppender">
    <file>${LOG_DIR}/ice-adapter.log</file>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %m \(%logger{36}:%L\)%n</pattern>
    </encoder>
  </appender>

  <root level="DEBUG">
    <appender-ref ref="STDOUT"/>
    <appender-ref ref="FILE"/>
  </root>
</configuration>
